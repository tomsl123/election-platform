{
  "name": "polling-station",
  "version": "0.1.0",
  "private": true,
  "description": "Polling Station: elections and referendums for the United States of Free Cliffs and other organisations",
  "scripts": {
    "init": "node scripts/init.mjs",
    "dev": "next dev -p 3220",
    "build": "prisma generate && next build",
    "start": "prisma migrate deploy && next start -p 3220",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "seed:demo": "tsx --env-file=.env prisma/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "16.4.6",
    "nodemailer": "^7.0.0",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
