# Copy to .env, or run `npm run init` to generate one with fresh secrets.

# SQLite database file, relative to the prisma/ folder.
DATABASE_URL="file:../data/elections.db"

# Master secret. Signs sessions and result seals, and encrypts stored SMTP/Discord
# credentials and 2FA secrets and device and IP evidence. At least 32 random characters. Changing it later
# invalidates stored credentials and makes old seals unverifiable.
APP_SECRET="change-me-to-a-long-random-string"

# One-time token required on /setup to create the first platform admin account.
SETUP_TOKEN="change-me-too"

# Public address of the site, used in e-mail and Discord links.
# Can also be set later under Platform > Settings.
BASE_URL="http://localhost:3220"

# Where uploaded images (crests, candidate photos) are stored.
UPLOAD_DIR="./data/uploads"

# Set to "1" when the app sits behind a reverse proxy that sets X-Forwarded-For
# and terminates TLS (marks cookies Secure and trusts the forwarded client IP).
TRUST_PROXY="0"
